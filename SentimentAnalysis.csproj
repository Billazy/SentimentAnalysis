<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--<None Update="Data\yelp_labelled.txt">-->
	  <!-- Copie automatique de tous les fichiers .txt du dossier Data
       vers bin\Debug\net10.0\Data\ à chaque build -->
	  <None Update="Data\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
